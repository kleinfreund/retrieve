{
	"name": "retrieve",
	"version": "3.0.0",
	"license": "MIT",
	"description": "A convenience wrapper around fetch",
	"author": {
		"name": "Philipp Rudloff",
		"url": "https://kleinfreund.de"
	},
	"homepage": "https://github.com/kleinfreund/retrieve",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kleinfreund/retrieve.git"
	},
	"bugs": {
		"url": "https://github.com/kleinfreund/retrieve/issues"
	},
	"keywords": [
		"fetch",
		"http",
		"request",
		"wrapper"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/retrieve.d.ts",
			"default": "./dist/retrieve.js"
		}
	},
	"types": "./dist/retrieve.d.ts",
	"files": [
		"dist/retrieve.d.ts",
		"dist/retrieve.js"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"start": "vite",
		"test": "run-s test:jsdom test:node",
		"test:jsdom": "vitest run --coverage --environment jsdom",
		"test:jsdom:watch": "vitest --environment jsdom",
		"test:node": "vitest run --coverage --environment node",
		"test:node:watch": "vitest --environment node",
		"lint": "run-p lint:*",
		"lint:code": "eslint",
		"lint:lockfile": "lockfile-lint --path package-lock.json --validate-hosts --allowed-hosts npm",
		"lint:package": "publint",
		"lint:types": "tsc --noEmit",
		"fix": "run-p fix:*",
		"fix:code": "npm run lint:code -- --fix",
		"release": "semantic-release",
		"prepare": "husky",
		"prepublishOnly": "npm run build"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.22.3"
		},
		"packageManager": {
			"name": "npm",
			"version": "^10.9.8"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@commitlint/types": "^21.0.1",
		"@eslint/js": "^10.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitest/coverage-v8": "^4.1.6",
		"eslint": "^10.3.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lockfile-lint": "^5.0.0",
		"npm-run-all2": "^8.0.4",
		"publint": "^0.3.21",
		"semantic-release": "^25.0.3",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6"
	}
}
